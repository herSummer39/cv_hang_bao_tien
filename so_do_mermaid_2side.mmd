    classDef aiStyle fill:#ffffff,stroke:#059669,stroke-width:2.5px,color:#0f172a;
    classDef dbStyle fill:#ffffff,stroke:#ea580c,stroke-width:2.5px,color:#0f172a;

    class C1,C2,C3,C4,C5 candidateStyle;
    class H1,H2,H3 hrStyle;
